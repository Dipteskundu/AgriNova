# AgriNova Node.js Main Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Python FastAPI Microservice Endpoint
AI_SERVICE_URL=http://127.0.0.1:8000

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.agrinova.mongodb.net/agrinova?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_with_a_long_random_secret
