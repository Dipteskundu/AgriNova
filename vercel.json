    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyAxhAHWU25Zcpt4t0hbzOQMV-xMiqclvnI",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "mentro-71aca.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "mentro-71aca",
