# Copy to .env and fill in real values. Every key the app reads is listed.

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
# production enables the strict CORS allowlist (FRONTEND_URL); any other
# value allows all origins (local dev, where ports hop between 3000/3001/…)
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?appName=Farmpath

# ── Auth ────────────────────────────────────────────────────────────────
# Use a long random string in production (Render can generate one)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=30d

# ── Deployment ──────────────────────────────────────────────────────────
# Deployed frontend origin(s), comma-separated. Required in production —
# this is the CORS allowlist.
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (used to build absolute /uploads URLs in
# disk-storage mode; unused when Cloudinary is configured)
PUBLIC_API_URL=http://localhost:5000

# ── File uploads ────────────────────────────────────────────────────────
# When all three are set, photos stream to Cloudinary (required on hosts
# with a read-only filesystem). When unset, files save to ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI service (optional) ───────────────────────────────────────────────
# FastAPI/XGBoost crop-advisory base URL. Leave unset to fail gracefully
# with a friendly message (10s timeout).
AI_SERVICE_URL=

# ── Escrow ──────────────────────────────────────────────────────────────
# Set to 1 to disable the hourly in-process escrow sweeper (server.js only;
# never runs under Vercel's api/index.js, which uses a cron instead)
DISABLE_ESCROW_SWEEP=
# Bearer token for GET /api/orders/escrow/cron (cron-style triggers)
CRON_SECRET=

# ── Legacy placeholders (read only by src/config/services.js, currently
# ── unused by the app — kept for compatibility) ─────────────────────────
WEATHER_API_KEY=
PAYMENT_GATEWAY_KEY=
AI_API_KEY=
CLOUD_STORAGE_BUCKET=
