# Copy to .env and fill in real values. Every key the app reads is listed.

# â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=5000
# production enables the strict CORS allowlist (FRONTEND_URL); any other
# value allows all origins (local dev, where ports hop between 3000/3001/â€¦)
NODE_ENV=development

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?appName=Farmpath

# â”€â”€ Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Use a long random string in production (Render can generate one)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=30d

# Firebase Admin authentication for verifying social sign-in ID tokens.
# Set FIREBASE_SERVICE_ACCOUNT to the service account JSON on hosts without
# Application Default Credentials. Set FIREBASE_PROJECT_ID to your Firebase
# project ID. Never commit a real service account key.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=


# â”€â”€ Deployment â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Deployed frontend origin(s), comma-separated. Required in production â€”
# this is the CORS allowlist.
FRONTEND_URL=http://localhost:3000
# Public base URL of this API (used to build absolute /uploads URLs in
# disk-storage mode; unused when Cloudinary is configured)
PUBLIC_API_URL=http://localhost:5000

# â”€â”€ File uploads â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# When all three are set, photos stream to Cloudinary (required on hosts
# with a read-only filesystem). When unset, files save to ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# â”€â”€ AI service (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# FastAPI/XGBoost crop-advisory base URL. Leave unset to fail gracefully
# with a friendly message (10s timeout).
AI_SERVICE_URL=

# â”€â”€ Escrow â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set to 1 to disable the hourly in-process escrow sweeper (server.js only;
# never runs under Vercel's api/index.js, which uses a cron instead)
DISABLE_ESCROW_SWEEP=
# Bearer token for GET /api/orders/escrow/cron (cron-style triggers)
CRON_SECRET=

# â”€â”€ Legacy placeholders (read only by src/config/services.js, currently
# â”€â”€ unused by the app â€” kept for compatibility) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WEATHER_API_KEY=
PAYMENT_GATEWAY_KEY=
AI_API_KEY=
CLOUD_STORAGE_BUCKET=
